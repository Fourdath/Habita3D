{
  "openapi": "3.1.0",
  "info": {
    "title": "Habita3D Python Service",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Get Health",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Get Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/recommendations/compare": {
      "post": {
        "tags": [
          "recommendations"
        ],
        "summary": "Compare Finishes",
        "operationId": "compare_finishes_recommendations_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/floors/budget": {
      "post": {
        "tags": [
          "floors"
        ],
        "summary": "Floor Budget",
        "description": "Calculate whole-box floor purchases using ordinary public CLP box prices.\n\nMissing price or coverage leaves the room uncalculable. An incomplete\nproject exposes an explicit partial subtotal and no final total or budget\nverdict. Availability is passed through, never inferred from a price.\nThe caller declares an ordinary public price; this endpoint does not verify\nits freshness or commercial conditions against the original retailer.",
        "operationId": "floor_budget_floors_budget_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FloorBudgetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FloorBudgetResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/materials/normalize": {
      "post": {
        "tags": [
          "materials"
        ],
        "summary": "Normalize",
        "description": "Pure validation of canonical raw records; never calls a retailer or writes a file.",
        "operationId": "normalize_materials_normalize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NormalizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NormalizeResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/materials/captures": {
      "post": {
        "tags": [
          "materials"
        ],
        "summary": "Create Capture",
        "description": "Explicit protected acquisition. Browsing/catalog reads must never call this route.",
        "operationId": "create_capture_materials_captures_post",
        "parameters": [
          {
            "name": "x-materials-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Materials-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/materials/status": {
      "get": {
        "tags": [
          "materials"
        ],
        "summary": "Capture Status",
        "description": "Local acquisition evidence only, not the future application's catalogue API.",
        "operationId": "capture_status_materials_status_get",
        "parameters": [
          {
            "name": "x-materials-token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Materials-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Capture Status Materials Status Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },

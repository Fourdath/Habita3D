# PostgreSQL
POSTGRES_USER=habita3d
# Local development only: replace with a unique URL-safe password before starting Compose.
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_DB=habita3d
POSTGRES_PORT=5432

# Backend (NestJS)
NODE_ENV=development
BACKEND_PORT=3000
APP_VERSION=local
# Shared internal acquisition credential: generate at least 24 random characters.
# Never expose it in Angular, screenshots or logs. start-local.ps1 generates one locally.
MATERIALS_API_TOKEN=replace-with-a-random-token-of-at-least-24-characters
# Enable only on the intended Windows demo host; disabled by default and in CI.
# NestJS coordinates 08:00, 12:00 and 16:00 America/Santiago. Do not also run app.capture --schedule.
MATERIALS_SCHEDULE_ENABLED=false

# Python service (FastAPI)
PYTHON_SERVICE_PORT=8000

# Frontend (Ionic/Angular, served via nginx in the container)
FRONTEND_PORT=8080
